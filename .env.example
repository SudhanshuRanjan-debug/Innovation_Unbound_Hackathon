# FinShield Environment Configuration

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/finshield
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finshield
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# AI/LLM Configuration
# =============================================================================
# Choose your LLM provider (openai, anthropic, etc.)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM Model Configuration
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_WORKERS=1

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# Financial Engine Configuration
# =============================================================================
# Risk Score Thresholds
RISK_THRESHOLD_CRITICAL=30
RISK_THRESHOLD_AT_RISK=50
RISK_THRESHOLD_WATCH=70
RISK_THRESHOLD_HEALTHY=100

# Risk Weight Configuration (must sum to 1.0)
RISK_WEIGHT_INCOME_STABILITY=0.20
RISK_WEIGHT_LIQUIDITY=0.25
RISK_WEIGHT_DEBT_BURDEN=0.25
RISK_WEIGHT_PAYMENT_BEHAVIOR=0.15
RISK_WEIGHT_CREDIT_UTILIZATION=0.15

# Cash Flow Configuration
CASH_FLOW_FORECAST_DAYS=90
MINIMUM_SAFE_BALANCE=5000

# Intervention Thresholds
INTERVENTION_TRIGGER_SCORE=60
INTERVENTION_CRITICAL_SCORE=40

# =============================================================================
# Overdraft Configuration
# =============================================================================
OVERDRAFT_MAX_AMOUNT=50000
OVERDRAFT_MIN_INCOME=20000
OVERDRAFT_MAX_DAYS=30
OVERDRAFT_INTEREST_RATE_DAILY=0.05
OVERDRAFT_PROCESSING_FEE=100

# =============================================================================
# Loan Configuration
# =============================================================================
LOAN_MIN_AMOUNT=10000
LOAN_MAX_AMOUNT=5000000
LOAN_MIN_TENURE_MONTHS=6
LOAN_MAX_TENURE_MONTHS=120

# Loan Comparison Weights (must sum to 1.0)
LOAN_WEIGHT_TOTAL_COST=0.30
LOAN_WEIGHT_EMI_AFFORDABILITY=0.25
LOAN_WEIGHT_RESILIENCE_IMPACT=0.20
LOAN_WEIGHT_TENURE_SUITABILITY=0.10
LOAN_WEIGHT_FEES=0.05
LOAN_WEIGHT_FLEXIBILITY=0.10

# =============================================================================
# ML Model Configuration
# =============================================================================
ML_MODEL_PATH=./models/distress_predictor.pkl
ML_RETRAIN_INTERVAL_DAYS=30
ML_PREDICTION_THRESHOLD=0.6

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/finshield.log

# =============================================================================
# Security Configuration
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
SESSION_TIMEOUT_MINUTES=30
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_EXPLANATIONS=true
FEATURE_OVERDRAFT=true
FEATURE_LOAN_COMPARISON=true
FEATURE_WHATIF_SIMULATOR=true
FEATURE_ML_PREDICTIONS=true

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/finshield_test
GENERATE_SYNTHETIC_DATA=true
SYNTHETIC_CUSTOMER_COUNT=100

# =============================================================================
# Deployment Configuration
# =============================================================================
ENVIRONMENT=development
NODE_ENV=development
VERCEL_ENV=development
