# ==============================================================================
# FINSHIELD DIGITAL BANKING & FINANCIAL RESILIENCE PLATFORM
# ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & DATABASE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
